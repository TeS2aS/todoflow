PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/todo_app
# Atlas example, never commit real credentials:
# MONGO_URI=mongodb+srv://todoflow_app:<password>@<cluster-host>/todo_app?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5000
# Optional comma-separated list for production previews/custom domains:
CLIENT_URLS=
FRONTEND_URL=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
MONGO_CONNECT_RETRIES=3
MONGO_CONNECT_RETRY_DELAY_MS=2000
VAPID_PUBLIC_KEY=
